# Скопируй в .env и заполни: cp .env.example .env
# Файл .env в git не попадает.

# PostgreSQL (локально, docker compose)
POSTGRES_DB=maqala
POSTGRES_USER=maqala
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Строка подключения для коннекторов и сайта. Именно 127.0.0.1, а не localhost: база слушает
# только IPv4 (docker-compose.yml), а localhost в Node.js может уйти на IPv6 (::1).
DATABASE_URL=postgresql://maqala:change-me@127.0.0.1:5432/maqala

# OpenAlex (см. docs/data-sources.md)
# Бесплатный ключ: https://openalex.org/settings/api-key. Без него загрузка ограничена 10 000 статей.
OPENALEX_API_KEY=
# E-mail для связи, передаётся в запросах как mailto
OPENALEX_EMAIL=you@example.com

# Адрес сайта: нужен для входа через Google (адрес возврата {APP_URL}/api/auth/google/callback)
APP_URL=http://localhost:3000

# Вход через Google (необязательно; без ключей кнопки Google не будет).
# Ключи: https://console.cloud.google.com/apis/credentials → OAuth client ID → Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Загрузки из админки: 1 — сайт сам запускает python -m ingest.worker (только локально)
INGEST_AUTORUN=0
# Python с установленными зависимостями ingest, например ../.venv/Scripts/python.exe
INGEST_PYTHON=python
