# Скопируй в .env и заполни: cp .env.example .env
# Файл .env в git не попадает.

# PostgreSQL (локально, docker compose)
POSTGRES_DB=maqala
POSTGRES_USER=maqala
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Строка подключения для коннекторов и сайта
DATABASE_URL=postgresql://maqala:change-me@localhost:5432/maqala

# OpenAlex: e-mail для polite pool (запросы с e-mail обслуживаются стабильнее)
OPENALEX_EMAIL=you@example.com
